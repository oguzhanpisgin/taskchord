{
  "name": "taskchord",
  "displayName": "TaskChord",
  "description": "From issue to reviewed PR",
  "version": "0.0.1",
  "publisher": "taskchord",
  "private": true,
  "type": "module",
  "preview": true,
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.134.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.cjs",
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "TaskChord Doctor remains available. GitHub-backed Work and Proof commands are disabled until the workspace is trusted."
    }
  },
  "files": [
    "dist",
    "media",
    "package.json"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:integration": "pnpm build && tsx src/test/runTest.ts"
  },
  "dependencies": {
    "@taskchord/contracts": "workspace:*",
    "@taskchord/doctor": "workspace:*",
    "@taskchord/github": "workspace:*",
    "@taskchord/proof": "workspace:*",
    "@taskchord/runners": "workspace:*",
    "@taskchord/work": "workspace:*"
  },
  "devDependencies": {
    "@types/vscode": "1.134.0",
    "@vscode/test-electron": "3.1.0"
  },
  "contributes": {
    "commands": [
      {
        "command": "taskchord.runDoctor",
        "title": "Run Doctor",
        "category": "TaskChord",
        "icon": "$(pulse)"
      },
      {
        "command": "taskchord.runners.refresh",
        "title": "Refresh Runner Status",
        "category": "TaskChord",
        "icon": "$(refresh)"
      },
      {
        "command": "taskchord.runners.openSettings",
        "title": "Open Runner Settings",
        "category": "TaskChord",
        "icon": "$(settings-gear)"
      },
      {
        "command": "taskchord.work.refresh",
        "title": "Refresh Issues",
        "category": "TaskChord",
        "icon": "$(refresh)"
      },
      {
        "command": "taskchord.work.selectRepository",
        "title": "Select Repository",
        "category": "TaskChord",
        "icon": "$(repo)"
      },
      {
        "command": "taskchord.work.newContract",
        "title": "New Issue Contract",
        "category": "TaskChord",
        "icon": "$(new-file)"
      },
      {
        "command": "taskchord.work.editContract",
        "title": "Edit Issue Contract",
        "category": "TaskChord",
        "icon": "$(edit)"
      },
      {
        "command": "taskchord.work.previewAndSubmit",
        "title": "Preview and Submit Issue Contract",
        "category": "TaskChord",
        "icon": "$(preview)"
      },
      {
        "command": "taskchord.work.openOnGitHub",
        "title": "Open on GitHub",
        "category": "TaskChord",
        "icon": "$(link-external)"
      },
      {
        "command": "taskchord.work.setActiveGoal",
        "title": "Set as Active Goal",
        "category": "TaskChord",
        "icon": "$(target)"
      },
      {
        "command": "taskchord.work.clearActiveGoal",
        "title": "Clear Active Goal",
        "category": "TaskChord",
        "icon": "$(close)"
      },
      {
        "command": "taskchord.work.copyCodexHandoff",
        "title": "Preview and Copy Codex Handoff",
        "category": "TaskChord",
        "icon": "$(copy)"
      },
      {
        "command": "taskchord.proof.refresh",
        "title": "Refresh Proof",
        "category": "TaskChord",
        "icon": "$(refresh)"
      },
      {
        "command": "taskchord.proof.selectRepository",
        "title": "Select Proof Repository",
        "category": "TaskChord",
        "icon": "$(repo)"
      },
      {
        "command": "taskchord.proof.openDetails",
        "title": "Open Proof Details",
        "category": "TaskChord",
        "icon": "$(open-preview)"
      },
      {
        "command": "taskchord.proof.runBuild",
        "title": "Run Proof Build",
        "category": "TaskChord",
        "icon": "$(tools)"
      },
      {
        "command": "taskchord.proof.runTests",
        "title": "Run Proof Tests",
        "category": "TaskChord",
        "icon": "$(beaker)"
      },
      {
        "command": "taskchord.proof.accept",
        "title": "Accept Proof",
        "category": "TaskChord",
        "icon": "$(check-all)"
      },
      {
        "command": "taskchord.proof.requestChanges",
        "title": "Request Proof Changes",
        "category": "TaskChord",
        "icon": "$(request-changes)"
      },
      {
        "command": "taskchord.proof.clearDecision",
        "title": "Clear Proof Decision",
        "category": "TaskChord",
        "icon": "$(discard)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "taskchord-workbench",
          "title": "TaskChord Workbench",
          "icon": "media/taskchord.svg"
        }
      ]
    },
    "views": {
      "taskchord-workbench": [
        {
          "id": "taskchord.setup",
          "name": "Setup"
        },
        {
          "id": "taskchord.work",
          "name": "Work"
        },
        {
          "id": "taskchord.proof",
          "name": "Proof"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "taskchord.setup",
        "contents": "Run TaskChord's read-only doctor to check this execution environment.\n[Run Doctor](command:taskchord.runDoctor)"
      },
      {
        "view": "taskchord.work",
        "contents": "Load all open GitHub Issues for the selected repository.\n[Refresh Issues](command:taskchord.work.refresh)\n[New Issue Contract](command:taskchord.work.newContract)",
        "when": "taskchord.workState == idle"
      },
      {
        "view": "taskchord.work",
        "contents": "Trust this workspace to use GitHub-backed Work commands. Doctor remains available.",
        "when": "taskchord.workState == untrusted"
      },
      {
        "view": "taskchord.work",
        "contents": "Choose which workspace repository TaskChord should use.\n[Select Repository](command:taskchord.work.selectRepository)",
        "when": "taskchord.workState == selectRepository"
      },
      {
        "view": "taskchord.proof",
        "contents": "Collect changed files, build, tests, commit, PR/CI, and human-decision evidence on demand.\n[Refresh Proof](command:taskchord.proof.refresh)",
        "when": "taskchord.proofState == idle"
      },
      {
        "view": "taskchord.proof",
        "contents": "Trust this workspace to collect read-only Proof evidence.",
        "when": "taskchord.proofState == untrusted"
      },
      {
        "view": "taskchord.proof",
        "contents": "Choose which workspace repository TaskChord should inspect.\n[Select Repository](command:taskchord.proof.selectRepository)",
        "when": "taskchord.proofState == selectRepository"
      }
    ],
    "configuration": {
      "title": "TaskChord",
      "properties": {
        "taskchord.runners.symphony.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "machine-overridable",
          "description": "Allow TaskChord to check the local Symphony preview state endpoint when you explicitly refresh runner status."
        },
        "taskchord.runners.symphony.port": {
          "type": "number",
          "default": 4000,
          "minimum": 1,
          "maximum": 65535,
          "scope": "machine-overridable",
          "description": "Local Symphony preview state port. TaskChord always uses http://127.0.0.1:<port>/api/v1/state."
        }
      }
    },
    "menus": {
      "view/title": [
        {
          "command": "taskchord.runDoctor",
          "when": "view == taskchord.setup",
          "group": "navigation"
        },
        {
          "command": "taskchord.runners.refresh",
          "when": "view == taskchord.setup && isWorkspaceTrusted",
          "group": "navigation@1"
        },
        {
          "command": "taskchord.runners.openSettings",
          "when": "view == taskchord.setup && isWorkspaceTrusted",
          "group": "navigation@2"
        },
        {
          "command": "taskchord.work.refresh",
          "when": "view == taskchord.work && isWorkspaceTrusted",
          "group": "navigation@1"
        },
        {
          "command": "taskchord.work.newContract",
          "when": "view == taskchord.work && isWorkspaceTrusted",
          "group": "navigation@2"
        },
        {
          "command": "taskchord.work.selectRepository",
          "when": "view == taskchord.work && isWorkspaceTrusted",
          "group": "navigation@3"
        },
        {
          "command": "taskchord.runners.refresh",
          "when": "view == taskchord.work && isWorkspaceTrusted",
          "group": "navigation@4"
        },
        {
          "command": "taskchord.runners.openSettings",
          "when": "view == taskchord.work && isWorkspaceTrusted",
          "group": "navigation@5"
        },
        {
          "command": "taskchord.work.clearActiveGoal",
          "when": "view == taskchord.work && isWorkspaceTrusted && taskchord.hasActiveGoal",
          "group": "navigation@6"
        },
        {
          "command": "taskchord.proof.refresh",
          "when": "view == taskchord.proof && isWorkspaceTrusted",
          "group": "navigation@1"
        },
        {
          "command": "taskchord.proof.openDetails",
          "when": "view == taskchord.proof && isWorkspaceTrusted && taskchord.proofState == ready",
          "group": "navigation@2"
        },
        {
          "command": "taskchord.proof.selectRepository",
          "when": "view == taskchord.proof && isWorkspaceTrusted",
          "group": "navigation@3"
        },
        {
          "command": "taskchord.proof.runBuild",
          "when": "view == taskchord.proof && isWorkspaceTrusted && taskchord.proofState == ready",
          "group": "navigation@4"
        },
        {
          "command": "taskchord.proof.runTests",
          "when": "view == taskchord.proof && isWorkspaceTrusted && taskchord.proofState == ready",
          "group": "navigation@5"
        },
        {
          "command": "taskchord.proof.accept",
          "when": "view == taskchord.proof && isWorkspaceTrusted && taskchord.proofState == ready",
          "group": "navigation@6"
        },
        {
          "command": "taskchord.proof.requestChanges",
          "when": "view == taskchord.proof && isWorkspaceTrusted && taskchord.proofState == ready",
          "group": "navigation@7"
        },
        {
          "command": "taskchord.proof.clearDecision",
          "when": "view == taskchord.proof && isWorkspaceTrusted && taskchord.proofState == ready",
          "group": "navigation@8"
        }
      ],
      "view/item/context": [
        {
          "command": "taskchord.work.editContract",
          "when": "view == taskchord.work && viewItem == taskchord.contractIssue && isWorkspaceTrusted",
          "group": "inline@1"
        },
        {
          "command": "taskchord.work.openOnGitHub",
          "when": "view == taskchord.work && (viewItem == taskchord.contractIssue || viewItem == taskchord.readOnlyIssue) && isWorkspaceTrusted",
          "group": "inline@2"
        },
        {
          "command": "taskchord.work.setActiveGoal",
          "when": "view == taskchord.work && viewItem == taskchord.contractIssue && isWorkspaceTrusted",
          "group": "taskchord@1"
        },
        {
          "command": "taskchord.work.copyCodexHandoff",
          "when": "view == taskchord.work && viewItem == taskchord.contractIssue && isWorkspaceTrusted && taskchord.hasActiveGoal",
          "group": "taskchord@2"
        },
        {
          "command": "taskchord.runners.refresh",
          "when": "view == taskchord.work && viewItem == taskchord.runnerStatus && isWorkspaceTrusted",
          "group": "inline@1"
        },
        {
          "command": "taskchord.proof.openDetails",
          "when": "view == taskchord.proof && viewItem == taskchord.proofStrip && isWorkspaceTrusted",
          "group": "inline@1"
        }
      ],
      "editor/title": [
        {
          "command": "taskchord.work.previewAndSubmit",
          "when": "taskchord.isContractDraft && isWorkspaceTrusted",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "taskchord.runners.refresh",
          "when": "isWorkspaceTrusted"
        },
        {
          "command": "taskchord.runners.openSettings",
          "when": "isWorkspaceTrusted"
        },
        {
          "command": "taskchord.work.refresh",
          "when": "isWorkspaceTrusted"
        },
        {
          "command": "taskchord.work.selectRepository",
          "when": "isWorkspaceTrusted"
        },
        {
          "command": "taskchord.work.newContract",
          "when": "isWorkspaceTrusted"
        },
        {
          "command": "taskchord.work.editContract",
          "when": "false"
        },
        {
          "command": "taskchord.work.previewAndSubmit",
          "when": "isWorkspaceTrusted"
        },
        {
          "command": "taskchord.work.openOnGitHub",
          "when": "false"
        },
        {
          "command": "taskchord.work.setActiveGoal",
          "when": "false"
        },
        {
          "command": "taskchord.work.clearActiveGoal",
          "when": "isWorkspaceTrusted && taskchord.hasActiveGoal"
        },
        {
          "command": "taskchord.work.copyCodexHandoff",
          "when": "isWorkspaceTrusted && taskchord.hasActiveGoal"
        },
        {
          "command": "taskchord.proof.refresh",
          "when": "isWorkspaceTrusted"
        },
        {
          "command": "taskchord.proof.selectRepository",
          "when": "isWorkspaceTrusted"
        },
        {
          "command": "taskchord.proof.openDetails",
          "when": "isWorkspaceTrusted && taskchord.proofState == ready"
        },
        {
          "command": "taskchord.proof.runBuild",
          "when": "isWorkspaceTrusted && taskchord.proofState == ready"
        },
        {
          "command": "taskchord.proof.runTests",
          "when": "isWorkspaceTrusted && taskchord.proofState == ready"
        },
        {
          "command": "taskchord.proof.accept",
          "when": "isWorkspaceTrusted && taskchord.proofState == ready"
        },
        {
          "command": "taskchord.proof.requestChanges",
          "when": "isWorkspaceTrusted && taskchord.proofState == ready"
        },
        {
          "command": "taskchord.proof.clearDecision",
          "when": "isWorkspaceTrusted && taskchord.proofState == ready"
        }
      ]
    },
    "walkthroughs": [
      {
        "id": "taskchord.gettingStarted",
        "title": "Get started with TaskChord",
        "description": "Run TaskChord's read-only checks on demand.",
        "steps": [
          {
            "id": "taskchord.gettingStarted.runDoctor",
            "title": "Check your environment",
            "description": "Check the current execution environment without changing it.\n[Run Doctor](command:taskchord.runDoctor)",
            "media": {
              "markdown": "media/walkthrough.md"
            },
            "completionEvents": [
              "onCommand:taskchord.runDoctor"
            ]
          }
        ]
      }
    ]
  }
}
